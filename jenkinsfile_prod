pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'develop', url: 'https://github.com/Akshatha-gowda-28/Assignments.git'
            }
        }

        stage('Copy to Prod Server') {
            steps {
                sshagent (credentials: ['1']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ubuntu@<PROD_SERVER_IP> "mkdir -p /home/ubuntu/jenkins/workspace_prod"
                        scp -o StrictHostKeyChecking=no -r * ubuntu@<PROD_SERVER_IP>:/home/ubuntu/jenkins/workspace_prod/
                    """
                }
            }
        }
    }
}
