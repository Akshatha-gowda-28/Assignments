pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'develop', url: 'https://github.com/Akshatha-gowda-28/Assignments.git'
            }
        }

        stage('Copy to Test Server') {
            steps {
                sshagent (credentials: ['1']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ubuntu@<TEST_SERVER_IP> "mkdir -p /home/ubuntu/jenkins/workspace_test"
                        scp -o StrictHostKeyChecking=no -r * ubuntu@<TEST_SERVER_IP>:/home/ubuntu/jenkins/workspace_test/
                    """
                }
            }
        }
    }

    post {
        success {
            build job: 'Prod Job'   // automatically trigger prod job
        }
    }
}
